DB_PASSWORD=replace-with-a-local-development-password
# Local lab simulation controls (Target). Set false to disable creation and execution.
SIMULATIONS_ENABLED=true
# Operator-controlled closed endpoint for actual connection failure; never exposed as a UI URL.
CONNECTION_FAILURE_URL=http://127.0.0.1:1
# Generate a random 32-byte base64 key; preserve it across restarts. Never commit the real value.
REPLAY_KEY=replace-with-a-generated-base64-key
